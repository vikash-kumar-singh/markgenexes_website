NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/Nextgenx

APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Runtime
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
PUBLIC_LEAD_RATE_WINDOW_MS=60000
PUBLIC_LEAD_RATE_LIMIT=10

# Database
MONGO_URI=mongodb://127.0.0.1:27017/markgenexes
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0

# Authentication (use separate cryptographically random values of 32+ characters)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_ALLOWED_ROLES=admin,manager

# Persistent image storage for Admin -> Case Studies uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
REQUIRE_EMAIL_VERIFICATION=false

COMPANY_NAME=MarkGenexes
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com

# Optional: required only for persistent Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
COMPANY_NAME=MarkGenexes

# Optional careers mailbox sync
CAREERS_IMAP_HOST=
CAREERS_IMAP_PORT=993
CAREERS_IMAP_SECURE=true
CAREERS_IMAP_USER=
CAREERS_IMAP_PASSWORD=
CAREERS_IMAP_MAILBOX=INBOX
CAREERS_IMAP_DAYS=90
